# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit actual secrets.
#
# Paths below (BM25_INDEX_PATH, DATA_DIR) are relative to backend/, since
# that's the folder every script/uvicorn command is run from — see README.

# --- Database (Postgres + pgvector — Supabase or Neon free tier) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Embeddings (used by ingestion + dense retrieval — keep these two in sync) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- BM25 index location (relative to backend/) ---
BM25_INDEX_PATH=indexes/bm25.pkl

# --- Source PDFs folder (relative to backend/, i.e. repo_root/data) ---
DATA_DIR=../data

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM: local first, Groq as fallback when internet is available ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Seconds to wait for Ollama before falling back to Groq. Keep well under
# REQUEST_TIMEOUT / 2 — the graph's bounded retry can make up to 2 LLM calls
# per request (rewrite + generate), each paying this timeout on the way to
# Groq. See backend/generation/llm_client.py.
OLLAMA_TIMEOUT=15
# 0 forces CPU-only inference. -1 lets Ollama choose (GPU if available).
# Force 0 if you hit a CUDA crash — see llm_client.py docstring for the
# known issue on Ayush's dev machine.
OLLAMA_NUM_GPU=-1
GROQ_API_KEY=
# Check client.models.list() against your own key — availability varies by
# account. openai/gpt-oss-120b confirmed working as of this writing.
GROQ_MODEL=openai/gpt-oss-120b

# --- API layer ---
REQUEST_TIMEOUT=90
CORS_ORIGINS=*
# Leave unset for local dev (/ingest is open). Set before deploying anywhere
# reachable from the internet.
ADMIN_TOKEN=

# --- Translation (Module 8, stretch — not built yet) ---
BHASHINI_API_KEY=
# Faster-to-obtain fallback if a Bhashini key isn't in hand by the demo —
# see CLAUDE.md's "Still open" note.
SARVAM_API_KEY=
